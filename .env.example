# Server-side only. Never prefixed VITE_ — that would inline it into the client
# bundle, where anyone could read it. See src/config.leak.test.ts, which fails
# the build if a key ever reaches the browser again.
#
# Local dev:  vercel env pull  (or set it in your shell before `vercel dev`)
# Production: vercel env add GEMINI_API_KEY production
#
# Entirely optional. With no key the app runs on its deterministic parser and
# says so; only the LLM fallback and the agent route are unavailable.
GEMINI_API_KEY=
