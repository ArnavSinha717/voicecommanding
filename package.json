{
  "name": "voice-shopping-list",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit && tsc --noEmit -p tsconfig.scripts.json && tsc --noEmit -p api/tsconfig.json",
    "eval": "vite-node scripts/eval.ts",
    "eval:errors": "vite-node scripts/errors.ts",
    "build:catalog": "vite-node scripts/build-catalog.ts",
    "tune:threshold": "vite-node scripts/tune-threshold.ts",
    "test:leak": "vitest run tests/config.leak.test.ts",
    "verify": "npm run typecheck && npx oxlint src scripts api && npm test && npm run build",
    "deploy": "vercel deploy --prod",
    "build:priors": "vite-node scripts/build-priors.ts",
    "tune:prior": "vite-node scripts/tune-prior.ts"
  },
  "dependencies": {
    "double-metaphone": "^2.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.11",
    "fast-check": "^4.9.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "playwright": "^1.62.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.11"
  },
  "description": "Voice-driven shopping list with measured NLP, multilingual support, and derived data."
}
